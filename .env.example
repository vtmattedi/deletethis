# ESP32 TCP audio stream.
AUDIO_TARGET=10.10.3.17:3333

# Host port for the browser/API. The container always listens on 8000.
AUDIO_HTTP_PORT=8000

# Keeps event filenames and timestamps aligned with the host installation.
AUDIO_TIMEZONE=America/Sao_Paulo

# MQTT (HiveMQ Cloud). Leave MQTT_HOST empty to publish nothing.
# Watson (v2) publishes to <prefix>/fan, <prefix>/compressor ("1"/"0",
# retained) and <prefix>/beep ("1" on every beep).
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=tester
# A code on <prefix>/sent reaches Watson via the broker a moment after the
# command really went out; it is dated this many seconds earlier.
MQTT_SENT_LATENCY_SECONDS=2.0
