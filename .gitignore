# =============================================================================
# Secrets
#
# These patterns have no leading slash, so they match at any depth. A secret
# that gets moved or copied to a new folder must not quietly become tracked.
#
# creds.h carries the WiFi password, the MQTT broker password and the broker's
# root CA. include/creds.example.h is the template to copy; it is tracked, and
# the pattern below does not match it -- keep it in sync when adding a define.
# =============================================================================
creds.h
credentials.h
secrets.h
Creds/

.env
.env.*
!.env.example

# Keys and certificates. The example/template forms stay tracked.
*.pem
*.key
*.p12
*.pfx
!*.example.pem
!*.example.key

# =============================================================================
# Build output
# =============================================================================
.pio
.pioenvs
.piolibdeps
.clang_complete
.gcc-flags.json
compile_commands.json

# Generated by src/Version/script.py on every build.
/include/Version.h

# Transient markers written and removed by src/Version/script.py during a build.
# src/Version/version itself is tracked -- it is the version, not a build artifact.
/src/Version/.version_no_increment*

# --- HybridCompile leftovers -------------------------------------------------
# Generated by a `custom_sdkconfig` build (see platformio.ini), which is
# disabled and does not work on this host. None of it is source: managed_components
# alone is ~175MB of vendored ESP-IDF components fetched by the component manager.
/managed_components
/dependencies.lock
/sdkconfig.defaults
/sdkconfig.*
/CMakeLists.txt
/.dummy

# =============================================================================
# Host tooling (tools/audio)
# =============================================================================
__pycache__/
*.py[cod]
*.egg-info/

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Recorded audio and analyzer output. Datasets are large and are captured
# per-installation, so they do not belong in the repository.
tools/audio/recordings/*
!tools/audio/recordings/.gitkeep
tools/audio/plots/
*.wav

# =============================================================================
# Editors and OS
# =============================================================================
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

.idea/
*.swp
*.swo
*~

.DS_Store
Thumbs.db
Desktop.ini

# Local agent configuration, not project source.
/.claude
tools/audio/results/*
!tools/audio/results/.gitkeep